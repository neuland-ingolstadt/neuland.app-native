{
	"version": "0.17.0",
	"name": "neuland",
	"main": "expo-router/entry",
	"homepage": "https://github.com/neuland-ingolstadt/neuland.app-native",
	"private": true,
	"scripts": {
		"dev": "bun maplibre:worker && EXPO_UNSTABLE_MCP_SERVER=1 EXPO_USE_FAST_RESOLVER=1 expo start",
		"start": "bun maplibre:worker && EXPO_UNSTABLE_MCP_SERVER=1 EXPO_USE_FAST_RESOLVER=1 expo start --no-dev --clear --port 3000",
		"start:e2e": "bun maplibre:worker && expo start --no-dev --minify --port 8081",
		"atlas": "bun maplibre:worker && EXPO_UNSTABLE_ATLAS=true npx expo export --platform all",
		"maplibre:worker": "bun config/sync-maplibre-worker.ts",
		"android": "expo run:android --device",
		"ios": "expo run:ios --device",
		"prebuild:ios": "expo prebuild -p ios",
		"prebuild:android": "expo prebuild -p android",
		"build:android": "bun licences && bun run prebuild:android && eas build --platform android --local",
		"build:android:dev": "bun licences && bun run prebuild:android && eas build --platform android --local --profile development",
		"build:ios": "bun run prebuild:ios && xcodebuild archive -workspace ios/NeulandNext.xcworkspace -scheme NeulandNext -configuration Release -archivePath ios/build/NeulandNext.xcarchive",
		"export:ios": "xcodebuild -exportArchive -archivePath ios/build/NeulandNext.xcarchive -exportPath ios/build/NeulandNext.ipa -exportOptionsPlist ios/exportOptions.plist && xcrun altool --upload-app -f ios/build/NeulandNext.ipa/NeulandNext.ipa -t ios -u $(security find-generic-password -s 'AppleAppStoreUpload' -g 2>&1 | grep -E 'acct' | awk -F= '{print $2}' | tr -d '\"') -p $(security find-generic-password -w -s 'AppleAppStoreUpload')",
		"ship:ios": "bun licences:bundle && bun build:ios && bun export:ios",
		"build:all": "bun licences:bundle && bun build:ios && bun build:android",
		"lint": "biome check",
		"fmt": "biome check --fix",
		"fmt:unsafe": "biome check --fix --unsafe",
		"licences": "npm-license-crawler -onlyDirectDependencies -json src/data/licenses.json",
		"licences:bundle": "npm-license-crawler -onlyDirectDependencies -json src/data/licenses.json && cp src/data/licenses.json src/data/package-licenses.json",
		"eas-build-post-install": "bun run licences:bundle && bun maplibre:worker",
		"codegen": "graphql-codegen --config config/codegen.yml",
		"changelog": "git cliff --config config/cliff.toml --output CHANGELOG.md",
		"pkgs": "bunx expo install --check",
		"doctor": "bunx expo-doctor",
		"test": "bun test --ci",
		"test:coverage": "bun test --ci --coverage --coverage-reporter=lcov --coverage-reporter=text",
		"test:mutation": "stryker run",
		"test:mutation:ci": "stryker run --concurrency 1",
		"test:mutation:check": "bun config/check-mutation-score.ts",
		"e2e": "bun config/run-maestro-suite.ts default",
		"e2e:ios": "bun config/run-maestro-suite.ts ios",
		"e2e:android": "bun config/run-maestro-suite.ts android",
		"e2e:authenticated": "bun config/run-maestro-tagged-suite.ts authenticated",
		"e2e:lecture": "bun config/run-maestro-tagged-suite.ts lecture",
		"e2e:member": "bun config/run-maestro-tagged-suite.ts member",
		"e2e:wallet": "bun config/run-maestro-tagged-suite.ts wallet",
		"e2e:logout": "bun config/run-maestro-tagged-suite.ts logout",
		"e2e:map:soak": "bun config/run-maestro-tagged-suite.ts map-soak",
		"e2e:web": "maestro test --platform=web --headless --screen-size=1440x1000 --config=.maestro/config.yaml -e WEB_URL=http://localhost:8081 --include-tags=web .maestro",
		"i18n:check": "i18n-check -l src/localization -s en -f i18next -u src -o missingKeys invalidKeys undefined",
		"changelog:check": "bun config/check-changelog-version.ts",
		"uniwind:types": "uniwind generate-artifacts --css ./src/global.css --dts ./src/uniwind-types.d.ts",
		"react:doctor": "bunx react-doctor@latest"
	},
	"dependencies": {
		"@aptabase/react-native": "^0.5.0",
		"@babel/runtime": "^7.28.4",
		"@bottom-tabs/react-navigation": "^0.12.0",
		"@expo/metro-runtime": "~6.1.2",
		"@expo/vector-icons": "^15.0.3",
		"@flipt-io/flipt": "^1.5.0",
		"@howljs/calendar-kit": "2.5.6",
		"@kichiyaki/react-native-barcode-generator": "^0.6.7",
		"@maplibre/maplibre-react-native": "11.3.6",
		"@react-native-community/datetimepicker": "8.4.4",
		"@react-native-community/netinfo": "11.4.1",
		"@react-navigation/elements": "^2.9.3",
		"@react-navigation/native": "^7.1.8",
		"@react-navigation/native-stack": "^7.3.16",
		"@react-navigation/stack": "^7.6.13",
		"@shopify/flash-list": "2.0.2",
		"@swmansion/react-native-bottom-sheet": "0.16.2",
		"@tanstack/query-sync-storage-persister": "5.101.4",
		"@tanstack/react-query": "5.101.4",
		"@tanstack/react-query-persist-client": "5.101.4",
		"@vis.gl/react-maplibre": "8.1.2",
		"burnt": "0.13.0",
		"color": "^5.0.3",
		"dayjs": "^1.11.21",
		"expo": "~54.0.37",
		"expo-alternate-app-icons": "3.0.0",
		"expo-application": "~7.0.8",
		"expo-auth-session": "~7.0.11",
		"expo-blur": "~15.0.8",
		"expo-brightness": "~14.0.8",
		"expo-clipboard": "~8.0.8",
		"expo-constants": "~18.0.14",
		"expo-dev-client": "~6.0.21",
		"expo-font": "~14.0.12",
		"expo-glass-effect": "~0.1.10",
		"expo-haptics": "~15.0.8",
		"expo-image": "~3.0.11",
		"expo-linear-gradient": "~15.0.8",
		"expo-linking": "~8.0.12",
		"expo-localization": "~17.0.9",
		"expo-quick-actions": "^6.0.0",
		"expo-router": "~6.0.24",
		"expo-secure-store": "~15.0.8",
		"expo-splash-screen": "~31.0.13",
		"expo-symbols": "~1.0.8",
		"expo-system-ui": "~6.0.9",
		"expo-updates": "~29.0.20",
		"expo-web-browser": "~15.0.11",
		"fuse.js": "^7.4.2",
		"graphql": "^17.0.1",
		"i18next": "26.4.0",
		"idb": "^8.0.3",
		"lucide-react-native": "^1.18.0",
		"luxon": "^3.7.2",
		"maplibre-gl": "6.3.0",
		"metro": "^0.83.3",
		"react": "19.1.0",
		"react-content-loader": "^7.1.1",
		"react-dom": "19.1.0",
		"react-i18next": "17.0.12",
		"react-native": "0.81.5",
		"react-native-bottom-tabs": "^0.12.0",
		"react-native-collapsible": "1.6.1",
		"react-native-context-menu-view": "^1.21.0",
		"react-native-device-info": "^15.0.2",
		"react-native-draggable-flatlist": "^4.0.3",
		"react-native-gesture-handler": "~2.28.0",
		"react-native-mmkv": "^4.3.2",
		"react-native-nitro-modules": "^0.36.1",
		"react-native-pager-view": "6.9.1",
		"react-native-reanimated": "~4.1.1",
		"react-native-safe-area-context": "~5.6.2",
		"react-native-screens": "~4.16.0",
		"react-native-select-dropdown": "^4.0.1",
		"react-native-svg": "15.12.1",
		"react-native-view-shot": "~4.0.3",
		"react-native-wallet-manager": "2.1.0",
		"react-native-web": "^0.21.2",
		"react-native-webview": "13.15.0",
		"react-native-worklets": "0.5.1",
		"react-qr-code": "^2.0.18",
		"sanitize-html": "^2.17.5",
		"swiftui-react-native": "^6.3.3",
		"tailwindcss": "^4.3.1",
		"uniwind": "^1.9.0",
		"zustand": "5.0.14"
	},
	"devDependencies": {
		"@0no-co/graphqlsp": "^1.17.3",
		"@babel/core": "^7.29.7",
		"@biomejs/biome": "2.5.11",
		"@eggl-js/expo-github-cache": "^0.4.0",
		"@graphql-codegen/cli": "7.3.1",
		"@graphql-codegen/client-preset": "6.1.3",
		"@graphql-codegen/schema-ast": "6.1.0",
