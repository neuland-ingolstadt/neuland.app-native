+++ b/ios/Common/ExpoView+UIHostingController.swift
@@ -1,6 +1,41 @@
 import SwiftUI
 import ExpoModulesCore
 
+class SwiftUIReactView: ExpoView {
+  private(set) var reactChildViews: [UIView] = []
+
+  override func mountChildComponentView(_ childComponentView: UIView, index: Int) {
+    super.mountChildComponentView(childComponentView, index: index)
+    if index < reactChildViews.count {
+      reactChildViews.insert(childComponentView, at: index)
+    } else {
+      reactChildViews.append(childComponentView)
+    }
+    updateReactSubviews()
+  }
+
+  override func unmountChildComponentView(_ childComponentView: UIView, index: Int) {
+    super.unmountChildComponentView(childComponentView, index: index)
+    if let childIndex = reactChildViews.firstIndex(where: { $0 === childComponentView }) {
+      reactChildViews.remove(at: childIndex)
+    }
+    updateReactSubviews()
+  }
+
+  func updateReactSubviews() {}
+
+}
+
+func swiftUIReactSubviews(_ view: UIView?) -> [UIView] {
+  guard let view else {
+    return []
+  }
+  if let view = view as? SwiftUIReactView {
+    return view.reactChildViews
+  }
+  return view.subviews
+}
+
